[Unit]
Description=Agendex directory and classification workspace
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agendex
Group=agendex
WorkingDirectory=/opt/agendex/app/system/web/backend
EnvironmentFile=/etc/agendex/agendex.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -s /var/lib/agendex/agendex.sqlite3
ExecStart=/opt/agendex/venv/bin/python -m uvicorn agendex.app:app --host 127.0.0.1 --port 8010 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agendex

[Install]
WantedBy=multi-user.target
